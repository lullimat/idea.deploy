*.DS_Store
*~
*__pycache__
*.ipynb_checkpoints
*.pyc
*slurm_engine.sbatch
*.err
*.out
*.vscode/

# docs/planning is a separate git repository (idea.deploy-planning.git) and
# docs/planning-safe is a working copy of it. Never track either from here:
# committing them would embed a gitlink pointing at a repo this one cannot resolve.
docs/planning/
docs/planning-safe/

# Build artefacts. setuptools writes src/idpy.egg-info/ on every editable
# install; it is generated, machine-specific and was never meant to be tracked.
*.egg-info/
build/
dist/
.venv/

!.gitignore
